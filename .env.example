# Copie para .env e ajuste conforme necessario.

# Opcional: habilita respostas sintetizadas com OpenAI.
OPENAI_API_KEY=your_openai_api_key_here

# Opcional: sobrescreve o modelo de chat do config.yaml.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Opcional: sobrescreve o modelo de embeddings quando provider=openai.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
